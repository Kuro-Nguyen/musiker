# -----------------------------------------------------------------------------
# Firebase Web SDK (Required for Authentication & Cloud Firestore Saved Crate)
# Create a project at https://console.firebase.google.com/ and register a Web App.
# Copy these values into .env.local (never commit .env.local).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Optional: Official Spotify Web API (Client Credentials Flow)
# Create a free app at https://developer.spotify.com/dashboard
# Even without Spotify keys, MUZIKER runs in Hybrid Multi-Country iTunes + RSS Chart mode.
# -----------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
